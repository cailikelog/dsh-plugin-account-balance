{
  "name": "dsh-plugin-account-balance",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: show the remaining DeepSeek account balance in the composer dock, right after the cache-hit reading.",
  "type": "module",
  "main": "./index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "account",
    "balance",
    "composer",
    "额度",
    "余额"
  ],
  "author": {
    "name": "cailikelog",
    "url": "https://github.com/cailikelog"
  },
  "homepage": "https://github.com/cailikelog/dsh-plugin-account-balance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cailikelog/dsh-plugin-account-balance.git"
  },
  "scripts": {
    "test": "node test/smoke.cjs"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT"
}
